Package: brmplus
Type: Package

Title: Extended Binary Regression Models for Small-Sample and Rare-Event Studies

Version: 1.1.0
Date: 2026-05-29

Authors@R: c(
    person("Conor", "Klamann",
           role = c("aut", "cre"),
